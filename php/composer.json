{
    "name": "apiverve/leetspeak",
    "description": "Leet Speak translates plain text into leet speak or reverses obfuscated strings back to standard words. Submit any string with an encode or decode mode to receive the converted text and a count of changed characters.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "leetspeak",
        "leet speak api",
        "leetspeak converter",
        "convert text to leet",
        "decode leet speak",
        "leet speak translator"
    ],
    "homepage": "https://apiverve.com/marketplace/leetspeak?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/leetspeak",
        "source": "https://github.com/apiverve/leetspeak-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Leetspeak\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Leetspeak\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
